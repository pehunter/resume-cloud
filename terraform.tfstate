      "name": "rendered_js",
      "provider": "provider[\"registry.terraform.io/hashicorp/local\"]",
      "instances": [
        {
          "schema_version": 0,
          "attributes": {
            "content": "const config = {\n    apiUrl: \"https://ph2szgf2qa.execute-api.us-east-1.amazonaws.com\"\n}\n\nfunction javascriptLoaded() {\n    fetch(\n      config.apiUrl + \"/visitor\",\n    )\n      .then((resp) =\u003e resp.text())\n      .then((val) =\u003e {\n            let elem = document.getElementById(\"jsload\");\n            elem.innerHTML = \"Site has been visited \" + val + \" times\";\n            elem.style = \"color: pink; background-color: black\";\n      });\n}\n\ndocument.addEventListener(\"DOMContentLoaded\", javascriptLoaded);",
            "content_base64": null,
            "content_base64sha256": "OD4ltZSZFITkReKCIE/Fg9sRpTIpaVDZCLN2Wwd1DTM=",
            "content_base64sha512": "qdTB6P6O7uhBGwlQ3LAeLWWCf9mALp4+gULy+z04GISP1RppeS81x1nkhRfD4Q/21Z8HJhGOtVJlp31mpQQUfg==",
            "content_md5": "728c72766d519f893ac028d8a1a4a960",
            "content_sha1": "42422f44b87cdebb38b9cb20b4afd3b9c8779a4d",
            "content_sha256": "383e25b594991484e445e282204fc583db11a532296950d908b3765b07750d33",
            "content_sha512": "a9d4c1e8fe8eeee8411b0950dcb01e2d65827fd9802e9e3e8142f2fb3d3818848fd51a69792f35c759e48517c3e10ff6d59f0726118eb55265a77d66a504147e",
            "directory_permission": "0777",
